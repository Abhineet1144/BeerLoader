#version 450

layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer VertexBuffer { uint vertices[]; };
layout(set = 0, binding = 1, std430) readonly buffer IndexBuffer { uint indices[]; };
layout(set = 0, binding = 2, std430) readonly buffer ConstantBuffer { uint constants_data[]; };
layout(set = 0, binding = 3, std430) buffer TargetBuffer { uint target_pixels[]; };
layout(set = 0, binding = 4, std430) readonly buffer TextureBuffer { uint texture_pixels[]; };

layout(push_constant) uniform Parameters {
    uint width;
    uint height;
    uint vertex_offset;
    uint index_offset;
    uint index_count;
    int base_vertex;
    uint mode;
    uint stride;
    vec4 viewport;
    ivec4 scissor;
    uint blend_enable;
    uint source_blend;
    uint destination_blend;
    uint color_operation;
    uint source_alpha;
    uint destination_alpha;
    uint alpha_operation;
    uint write_mask;
    vec4 blend_factor;
    uint texture_width;
    uint texture_height;
    uint sampler_flags;
    uint dispatch_origin_x;
    uint dispatch_origin_y;
    uint dispatch_width;
    uint dispatch_pixels;
} p;

uint load_byte(uint byte_offset)
{
    uint word = vertices[byte_offset >> 2];
    return (word >> ((byte_offset & 3u) * 8u)) & 255u;
}

uint load_index(uint index)
{
    uint byte_offset = p.index_offset + index * 2u;
    uint word = indices[byte_offset >> 2];
    return (word >> ((byte_offset & 2u) * 8u)) & 65535u;
}

float constant_float(uint index)
{
    return uintBitsToFloat(constants_data[index]);
}

float address_coordinate(float coordinate, uint mode)
{
    if (mode == 3u) return clamp(coordinate, 0.0, 1.0);
    float integral = floor(coordinate);
    coordinate -= integral;
    if (mode == 2u && (int(integral) & 1) != 0) coordinate = 1.0 - coordinate;
    return coordinate;
}

vec4 texture_texel(ivec2 coordinate)
{
    coordinate = clamp(coordinate, ivec2(0), ivec2(int(p.texture_width) - 1,
                                                   int(p.texture_height) - 1));
    uint pixel = uint(coordinate.y) * p.texture_width + uint(coordinate.x);
    if (p.mode == 5u) {
        uint word = texture_pixels[pixel >> 2u];
        float value = float((word >> ((pixel & 3u) * 8u)) & 255u) / 255.0;
        return vec4(value, 0.0, 0.0, 1.0);
    }
    return unpackUnorm4x8(texture_pixels[pixel]);
}

vec4 sample_texture(vec2 uv)
{
    uint address_u = (p.sampler_flags >> 1u) & 7u;
    uint address_v = (p.sampler_flags >> 4u) & 7u;
    uv.x = address_coordinate(uv.x, address_u);
    uv.y = address_coordinate(uv.y, address_v);
    if ((p.sampler_flags & 1u) == 0u) {
        ivec2 coordinate = ivec2(uv * vec2(p.texture_width, p.texture_height));
        return texture_texel(coordinate);
    }
    vec2 texel = uv * vec2(p.texture_width, p.texture_height) - vec2(0.5);
    ivec2 base = ivec2(floor(texel));
    vec2 fraction_value = fract(texel);
    vec4 top = mix(texture_texel(base), texture_texel(base + ivec2(1, 0)),
                   fraction_value.x);
    vec4 bottom = mix(texture_texel(base + ivec2(0, 1)),
                      texture_texel(base + ivec2(1, 1)), fraction_value.x);
    return mix(top, bottom, fraction_value.y);
}

struct Vertex {
    vec2 position;
    vec4 color0;
    vec4 color1;
    vec2 uv;
};

Vertex load_vertex(uint index)
{
    uint offset = p.vertex_offset + index * p.stride;
    Vertex result;
    result.color0 = vec4(load_byte(offset), load_byte(offset + 1u),
                         load_byte(offset + 2u), load_byte(offset + 3u)) / 255.0;
    result.color1 = p.stride == 16u
        ? vec4(load_byte(offset + 4u), load_byte(offset + 5u),
               load_byte(offset + 6u), load_byte(offset + 7u)) / 255.0
        : vec4(1.0);
    uint position_offset = offset + (p.stride == 16u ? 8u :
                                     p.stride == 20u ? 12u : 4u);
    vec2 input_position = vec2(uintBitsToFloat(vertices[position_offset >> 2]),
                               uintBitsToFloat(vertices[(position_offset + 4u) >> 2]));
    uint row = (p.mode == 2u || p.mode == 3u || p.mode == 5u) ? 8u : 0u;
    vec2 clip_position = vec2(
        input_position.x * constant_float(row) +
        input_position.y * constant_float(row + 1u) + constant_float(row + 3u),
        input_position.x * constant_float(row + 4u) +
        input_position.y * constant_float(row + 5u) + constant_float(row + 7u));
    result.position = vec2(p.viewport.x + (clip_position.x + 1.0) * p.viewport.z * 0.5,
                           p.viewport.y + (1.0 - clip_position.y) * p.viewport.w * 0.5);
    if (p.mode == 2u) {
        vec4 add_value = vec4(constant_float(0u), constant_float(1u),
                              constant_float(2u), constant_float(3u));
        vec4 multiply_value = vec4(constant_float(4u), constant_float(5u),
                                   constant_float(6u), constant_float(7u));
        result.color0 = result.color0 * multiply_value + add_value;
    }
    if (p.mode == 3u) {
        result.uv = vec2(
            input_position.x * constant_float(16u) + input_position.y * constant_float(17u) + constant_float(19u),
            input_position.x * constant_float(20u) + input_position.y * constant_float(21u) + constant_float(23u));
        result.color0.a = result.color0.a * constant_float(7u) + constant_float(3u);
    } else if (p.mode == 4u) {
        result.uv = vec2(
            input_position.x * constant_float(8u) + input_position.y * constant_float(9u) + constant_float(11u),
            input_position.x * constant_float(12u) + input_position.y * constant_float(13u) + constant_float(15u));
    } else if (p.mode == 5u) {
        result.uv = vec2(uintBitsToFloat(vertices[(offset + 4u) >> 2]),
                         uintBitsToFloat(vertices[(offset + 8u) >> 2]));
        vec4 add_value = vec4(constant_float(0u), constant_float(1u),
                              constant_float(2u), constant_float(3u));
        vec4 multiply_value = vec4(constant_float(4u), constant_float(5u),
                                   constant_float(6u), constant_float(7u));
        result.color0 = result.color0 * multiply_value + add_value;
    } else {
        result.uv = vec2(0.0);
    }
    return result;
}

float blend_factor_value(uint factor, uint channel, vec4 source, vec4 destination)
{
    if (factor == 1u) return 0.0;
    if (factor == 2u) return 1.0;
    if (factor == 3u) return source[channel];
    if (factor == 4u) return 1.0 - source[channel];
    if (factor == 5u) return source.a;
    if (factor == 6u) return 1.0 - source.a;
    if (factor == 7u) return destination.a;
    if (factor == 8u) return 1.0 - destination.a;
    if (factor == 9u) return destination[channel];
    if (factor == 10u) return 1.0 - destination[channel];
    if (factor == 11u) return channel == 3u ? 1.0 : min(source.a, 1.0 - destination.a);
    if (factor == 14u) return p.blend_factor[channel];
    if (factor == 15u) return 1.0 - p.blend_factor[channel];
    return 1.0;
}

float blend_operation(uint operation, float source, float destination)
{
    if (operation == 1u) return source + destination;
    if (operation == 2u) return source - destination;
    if (operation == 3u) return destination - source;
    if (operation == 4u) return min(source, destination);
    if (operation == 5u) return max(source, destination);
    return source;
}

vec4 blend(vec4 source, vec4 destination)
{
    if (p.blend_enable == 0u) return source;
    vec4 output_value;
    for (uint channel = 0u; channel < 3u; ++channel) {
        float sf = blend_factor_value(p.source_blend, channel, source, destination);
        float df = blend_factor_value(p.destination_blend, channel, source, destination);
        output_value[channel] = blend_operation(
            p.color_operation, source[channel] * sf, destination[channel] * df);
    }
    float sf = blend_factor_value(p.source_alpha, 3u, source, destination);
    float df = blend_factor_value(p.destination_alpha, 3u, source, destination);
    output_value.a = blend_operation(
        p.alpha_operation, source.a * sf, destination.a * df);
    return output_value;
}

void main()
{
    uint local_pixel = gl_GlobalInvocationID.x;
    if (local_pixel >= p.dispatch_pixels) return;
    uint x = p.dispatch_origin_x + local_pixel % p.dispatch_width;
    uint y = p.dispatch_origin_y + local_pixel / p.dispatch_width;
    uint pixel = y * p.width + x;
    if (int(x) < p.scissor.x || int(y) < p.scissor.y ||
        int(x) >= p.scissor.z || int(y) >= p.scissor.w)
        return;

    vec4 destination = unpackUnorm4x8(target_pixels[pixel]);
    vec2 sample_position = vec2(float(x) + 0.5, float(y) + 0.5);
    for (uint first = 0u; first + 2u < p.index_count; first += 3u) {
        int i0 = int(load_index(first)) + p.base_vertex;
        int i1 = int(load_index(first + 1u)) + p.base_vertex;
        int i2 = int(load_index(first + 2u)) + p.base_vertex;
        if (i0 < 0 || i1 < 0 || i2 < 0) continue;
        Vertex v0 = load_vertex(uint(i0));
        Vertex v1 = load_vertex(uint(i1));
        Vertex v2 = load_vertex(uint(i2));
        float area = (v2.position.x - v0.position.x) * (v1.position.y - v0.position.y) -
                     (v2.position.y - v0.position.y) * (v1.position.x - v0.position.x);
        if (area == 0.0) continue;
        float w0 = ((sample_position.x - v1.position.x) * (v2.position.y - v1.position.y) -
                    (sample_position.y - v1.position.y) * (v2.position.x - v1.position.x)) / area;
        float w1 = ((sample_position.x - v2.position.x) * (v0.position.y - v2.position.y) -
                    (sample_position.y - v2.position.y) * (v0.position.x - v2.position.x)) / area;
        float w2 = 1.0 - w0 - w1;
        if (w0 < 0.0 || w1 < 0.0 || w2 < 0.0) continue;
        vec4 color0 = v0.color0 * w0 + v1.color0 * w1 + v2.color0 * w2;
        float secondary_alpha = v0.color1.a * w0 + v1.color1.a * w1 + v2.color1.a * w2;
        if (p.mode == 3u || p.mode == 4u || p.mode == 5u) {
            vec2 uv = v0.uv * w0 + v1.uv * w1 + v2.uv * w2;
            vec4 texture_color = sample_texture(uv);
            if (p.mode == 5u) {
                color0.a *= texture_color.r;
            } else {
                color0.rgb = texture_color.rgb;
                color0.a *= texture_color.a;
            }
        } else {
            color0.a *= secondary_alpha;
        }
        vec4 result = clamp(blend(color0, destination), 0.0, 1.0);
        for (uint channel = 0u; channel < 4u; ++channel)
            if ((p.write_mask & (1u << channel)) != 0u)
                destination[channel] = result[channel];
    }
    target_pixels[pixel] = packUnorm4x8(destination);
}
