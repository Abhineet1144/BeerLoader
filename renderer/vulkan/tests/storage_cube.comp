#version 450
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D target_image;
layout(set = 0, binding = 1) uniform textureCube source_image;
layout(set = 0, binding = 2) uniform sampler source_sampler;
void main()
{
    vec4 color = textureLod(samplerCube(source_image, source_sampler),
                            vec3(1.0, 0.0, 0.0), 0.0);
    imageStore(target_image, ivec2(0, 0), color);
}
