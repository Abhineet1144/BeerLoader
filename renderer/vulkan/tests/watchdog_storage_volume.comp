#version 450
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, rgba8) uniform writeonly image3D target_image;

void main()
{
    for (uint iteration = 0; iteration < 2; ++iteration)
        barrier();
    imageStore(target_image, ivec3(gl_WorkGroupID.x, 0, 0),
               vec4(float(gl_WorkGroupID.x + 1), 0.0, 0.0, 1.0));
}
