#version 450
layout(local_size_x = 1, local_size_y = 1) in;
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outputImage;
layout(set = 0, binding = 1) uniform texture2D sourceImage;
layout(set = 0, binding = 2) uniform sampler sourceSampler;
void main()
{
    imageStore(outputImage, ivec2(0, 0),
        textureLod(sampler2D(sourceImage, sourceSampler), vec2(0.5), 1.0));
}
