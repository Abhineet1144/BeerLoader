#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer Source { uint source_data[]; };
layout(set = 0, binding = 1) buffer Destination { uint destination_data[]; };
layout(set = 0, binding = 2) uniform Params { uvec4 params; };

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index < params.x)
        destination_data[index] = source_data[index] * params.y + params.z;
}
