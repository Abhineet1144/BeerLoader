#version 450
// Final-image effects: sharpen, white balance, brightness/contrast/gamma, saturation/vibrance,
// colour-vision correction or simulation, vignette, film grain, letterbox. Fixed-point (milli) parameters.
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba8) uniform readonly image2D uSrc;
layout(binding = 1, rgba8) uniform writeonly image2D uDst;
layout(push_constant) uniform Params {
    ivec2 size;
    int brightness, contrast, gamma, saturation;
    int vibrance, sharpen, vignette, grain;
    int temperature, colorblind, cb_strength, letterbox;
    int seed;
} p;

float hash(vec2 v) { return fract(sin(dot(v, vec2(12.9898, 78.233)) + float(p.seed) * 0.37) * 43758.5453); }

// Colour-vision deficiency simulation matrices (Vienot, Brettel, Mollon), linear-ish RGB.
const mat3 PROTAN = mat3(0.152286, 0.114503, -0.003882,  1.052583, 0.786281, -0.048116,  -0.204868, 0.099216, 1.051998);
const mat3 DEUTAN = mat3(0.367322, 0.280085, -0.011820,  0.860646, 0.672501, 0.042940,  -0.228008, 0.047413, 0.968881);
const mat3 TRITAN = mat3(1.255528, -0.078411, -0.004733,  -0.076749, 0.930809, 0.691367,  -0.178779, 0.147602, 0.313366);

void main()
{
    ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (xy.x >= p.size.x || xy.y >= p.size.y) return;
    vec3 c = imageLoad(uSrc, xy).rgb;

    if (p.sharpen > 0) {
        vec3 n = imageLoad(uSrc, clamp(xy + ivec2(0, -1), ivec2(0), p.size - 1)).rgb
               + imageLoad(uSrc, clamp(xy + ivec2(0, 1), ivec2(0), p.size - 1)).rgb
               + imageLoad(uSrc, clamp(xy + ivec2(-1, 0), ivec2(0), p.size - 1)).rgb
               + imageLoad(uSrc, clamp(xy + ivec2(1, 0), ivec2(0), p.size - 1)).rgb;
        c += (c - n * 0.25) * (float(p.sharpen) * 0.001);
    }
    // white balance: positive = warmer
    float t = float(p.temperature) * 0.001;
    c *= vec3(1.0 + 0.25 * t, 1.0, 1.0 - 0.25 * t);

    c += float(p.brightness) * 0.001;
    c = (c - 0.5) * (float(p.contrast) * 0.001) + 0.5;
    c = pow(max(c, vec3(0.0)), vec3(1.0 / max(float(p.gamma) * 0.001, 0.05)));

    float luma = dot(c, vec3(0.2126, 0.7152, 0.0722));
    c = mix(vec3(luma), c, float(p.saturation) * 0.001);
    if (p.vibrance != 0) {   // boosts dull colours more than vivid ones
        float mx = max(c.r, max(c.g, c.b)), mn = min(c.r, min(c.g, c.b));
        float sat = mx - mn;
        c = mix(vec3(luma), c, 1.0 + float(p.vibrance) * 0.001 * (1.0 - sat));
    }

    if (p.colorblind > 0) {
        mat3 m = (p.colorblind % 3 == 1) ? PROTAN : (p.colorblind % 3 == 2) ? DEUTAN : TRITAN;
        vec3 sim = clamp(m * c, 0.0, 1.0);
        if (p.colorblind >= 4) {          // 4..6: show how the deficiency looks
            c = mix(c, sim, float(p.cb_strength) * 0.001);
        } else {                          // 1..3: move the lost information into channels that stay visible
            vec3 err = c - sim;
            vec3 shifted = vec3(0.0, 0.7 * err.r + err.g, 0.7 * err.r + err.b);
            c += shifted * float(p.cb_strength) * 0.001;
        }
    }

    vec2 uv = (vec2(xy) + 0.5) / vec2(p.size);
    if (p.vignette > 0) {
        float d = distance(uv, vec2(0.5)) * 1.41421356;
        c *= 1.0 - float(p.vignette) * 0.001 * smoothstep(0.35, 1.0, d);
    }
    if (p.grain > 0) c += (hash(vec2(xy)) - 0.5) * float(p.grain) * 0.001 * 0.3;
    if (p.letterbox > 0) {
        float bar = float(p.letterbox) * 0.001;
        if (uv.y < bar || uv.y > 1.0 - bar) c = vec3(0.0);
    }
    imageStore(uDst, xy, vec4(clamp(c, 0.0, 1.0), 1.0));
}
